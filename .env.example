# LLM Config (OpenRouter)
OPENROUTER_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
OPENAI_REALTIME_MODEL=gpt-realtime
GEMINI_API_KEY=your_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Simulation — set to 1 to enable Claude semantic scoring on finalize (costs ~$0.02/session)
SIMULATION_USE_LLM_SCORER=1

# ASR/TTS Config
DEEPGRAM_API_KEY=your_key_here
DEEPGRAM_SIMULATION_MODEL=flux-general-en
CARTESIA_API_KEY=your_key_here
ELEVENLABS_API_KEY=your_key_here

# Infrastructure (Managed URLs for Cloud)
# Use Upstash for Redis: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379 
# Use Vercel Postgres or Supabase: postgresql://user:password@host:port/db
DATABASE_URL=postgresql://localhost:5432/antigravity
# Production readiness fails when durable report/event storage is unavailable.
ANTIGRAVITY_REQUIRE_POSTGRES=1

# Service Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PROVENHIRE_API_URL=http://localhost:10000
ANTIGRAVITY_WEBHOOK_SECRET=replace-with-same-secret-as-provenhire
